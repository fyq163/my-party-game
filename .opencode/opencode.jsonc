{
  "$schema": "https://opencode.ai/config.json",
  // ponytail: 本项目限定的 OpenCode 配置，物理文件放在 .agents 满足用户“最好放在 .agents” 的偏好，
  // 根目录 opencode.jsonc 为同一份文件的镜像/软链，OpenCode 启动时按 project config 优先级读取。
  // 仅 Cloudflare 官方推荐的 5 个 remote MCP（本文件不含 ssh-manager，见根 opencode.jsonc / .opencode/opencode.json）
  "mcp": {
    // Code Mode: 全量 Cloudflare API (2,500+ endpoints, ~1,000 tokens)
    // https://github.com/cloudflare/mcp
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    },
    // 文档检索 - 让 agent 用最新 docs 而非预训练知识
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    // Workers Bindings: KV/D1/R2/Vectorize/AI 等存储与计算原语
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    // Workers Builds: 构建流水线洞察
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    // Observability: 日志与分析排障
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": true
    }
  }
}

